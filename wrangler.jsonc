{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crossborder-cqe-sentinel",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "./start.sh --build-cloudflare"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./cloudflare/dist",
    "html_handling": "none",
    "run_worker_first": ["/", "/index.html", "/api/*", "/demo-source/*", "/healthz", "/docs", "/_sandbox/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "DEMO_SESSIONS", "class_name": "DemoSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DemoSession"] }
  ]
}
